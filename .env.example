# Copy this file to .env for local testing. Never commit .env.

# ── Google OAuth (primary auth method) ──────────────────────────────────────
# Create credentials at: console.cloud.google.com → APIs & Services → Credentials
# Type: OAuth 2.0 Web Application
# Authorized redirect URI: https://your-app.up.railway.app  (and http://localhost:8501 for local dev)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
APP_URL=https://your-app.up.railway.app
ALLOWED_EMAILS=vivek@example.com,teammate@example.com

# ── Password fallback (used only if GOOGLE_CLIENT_ID is not set) ─────────────
DASHBOARD_PASSWORD=choose-a-strong-password

# ── Anthropic — Claude API key ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Drive — paste the full contents of venue_extractor_service_account_key.json as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"..."}

# ── Xano endpoints ───────────────────────────────────────────────────────────
XANO_BASE_URL=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B
XANO_SUMMARY_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/extracted_pdf_data
XANO_PRICING_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/venue_pricing
XANO_GET_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/wptp_pdfs
# Dedicated PATCH base for writing extraction status back to wptp_pdfs rows.
# Should point to the same path as XANO_GET_ENDPOINT — kept separate so the
# PATCH route is explicit and won't silently no-op if Xano routing changes.
# Falls back to XANO_GET_ENDPOINT if not set.
XANO_PATCH_PDF_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/wptp_pdfs

# ── Vendor Scraper (photographer pricing) ────────────────────────────────────
# GET worklist of photographers (table 11 WHERE Category="Photographer").
XANO_PHOTOGRAPHERS_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/photographers_worklist
# POST one row into the new photographer_pricing observations table.
XANO_OBSERVATION_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/photographer_observation
# PATCH base for writing scrape_status back to table 11 rows (PATCH /{id}).
XANO_PATCH_VENDOR_ENDPOINT=https://xqtb-2ma7-ijfy.n7e.xano.io/api:GynP5T1B/photographers_worklist

# ── Reddit Data API (Phase 2 — optional; scraper skips Reddit until all 3 set) ─
# Create a "script" app at reddit.com/prefs/apps. Read-only is sufficient.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:tulle-pricing:v1.0 (by /u/yourusername)

# ── Optional polite-scraper overrides ────────────────────────────────────────
# SCRAPER_USER_AGENT=TulleTogetherBot/1.0 (+https://tulletogether.com/bot; contact: data@tulletogether.com)
# SCRAPER_PER_DOMAIN_INTERVAL=10
